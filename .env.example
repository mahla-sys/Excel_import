# School Data Intake Portal — production environment template.
#
# Copy to .env, fill every value, and NEVER commit the real .env.
# Generate a strong SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
DJANGO_SECURE=1
ALLOWED_HOSTS=import.example.com
CSRF_TRUSTED_ORIGINS=https://import.example.com
CORS_ALLOWED_ORIGINS=https://import.example.com

# --- Domain / Caddy ---
DOMAIN=import.example.com

# --- PostgreSQL ---
POSTGRES_DB=intake
POSTGRES_USER=intake
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Upload limits (MVP) ---
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_ROWS=5000

# --- Storage (inside container; use Docker volumes in prod) ---
PRIVATE_STORAGE_ROOT=/data/private_files
